root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,go.sum,Makefile}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Golden files hold the exact output the tests expect.
[*.golden]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
