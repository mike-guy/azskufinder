{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':enablePreCommit',
    'customManagers:githubActionsVersions',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  labels: [
    'dependencies',
  ],
  automerge: false,
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
  },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: 'Go modules and the Go toolchain are compiled into the binary, so an update calls for a patch release',
      matchManagers: [
        'gomod',
      ],
      semanticCommitType: 'fix',
    },
    {
      description: 'One pull request per kind of dependency for minor and patch updates; majors stay separate',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'Go modules',
    },
    {
      matchManagers: [
        'mise',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'development tools',
    },
    {
      description: 'Tools and mise itself wait a few days after release, so their binaries exist when mise.lock is generated. Python is built by python-build-standalone after CPython tags a release; without the wait, mise.lock loses its download URLs and every locked CI job fails. Three days is a starting value, not a measured one',
      matchManagers: [
        'mise',
      ],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'The mise version pin in the workflows is downloaded from a GitHub release',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'jdx/mise',
      ],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'mise itself goes with the tools it installs',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'jdx/mise',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'development tools',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pinDigest',
      ],
      groupName: 'GitHub Actions',
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'pre-commit hooks',
    },
  ],
}
